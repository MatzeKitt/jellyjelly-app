    "A playing video moves into a floating window when you switch to another app and back into the player when you return." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein laufendes Video wechselt in ein schwebendes Fenster, wenn du zu einer anderen App wechselst, und zurück in den Player, sobald du zurückkehrst."
          }
        }
      }
    },
    "A/V sync" : {
      "extractionState" : "stale",
